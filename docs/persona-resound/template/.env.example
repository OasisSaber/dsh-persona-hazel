# 复制本文件为 .env.prod 并填入真实 key（.env.prod 已被 gitignore）
# 对话模型（DeepSeek，OpenAI 兼容）
OPENAI_API_KEY=你的DeepSeek_API_Key
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash

# Embedding + 视觉（智谱，OpenAI 兼容）
ZHIPU_API_KEY=你的智谱AI_API_Key

# 感知增强（均可留空，留空则对应功能跳过）
WEATHER_KEY=和风天气Key
WEATHER_BASE_URL=你的和风专属域名
WEATHER_CITY=角色所在地城市
VISION_MODEL=glm-4.6v

# B站联动（可选，留空关闭）
BILI_UID=角色的B站UID
BILI_SESSDATA=你的B站登录Cookie
NOTIFY_FRIENDS_WHITELIST=   # 推送白名单QQ号（逗号分隔，留空=全部好友）
